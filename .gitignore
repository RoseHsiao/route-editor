# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# ── TrailPlanner ──────────────────────────────────────────────
# Keep the template, never real env files.
!.env.example

# Generated Prisma client
/lib/generated/

# Local file storage, uploads, generated exports
/.data/
/uploads/

# Private datasets and personal GPX files. NEVER commit these.
# Third-party data without redistribution rights belongs here (see docs/DATA_SOURCES.md).
/fixtures/private/*
!/fixtures/private/README.md
*TMBMAP*
*tmbmap*

# Test output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Python worker
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
