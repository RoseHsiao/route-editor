# Copy to .env for local development:  cp .env.example .env
# Never commit .env or any file containing real credentials.

# ── Database ──────────────────────────────────────────────────────────────
# Matches docker-compose.yml (local only). Port 5433 avoids clashing with a host Postgres.
DATABASE_URL="postgresql://trailplanner:trailplanner@localhost:5433/trailplanner"
# Separate database used by integration tests. It is reset by the test setup.
TEST_DATABASE_URL="postgresql://trailplanner:trailplanner@localhost:5433/trailplanner_test"

# ── File storage ──────────────────────────────────────────────────────────
# "local" (filesystem, development only) or "s3" (any S3-compatible service).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/storage"
# Required when STORAGE_DRIVER="s3".
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ── Map ───────────────────────────────────────────────────────────────────
# MapLibre style URL. OpenFreeMap is used for development; see docs/DATA_SOURCES.md
# before choosing a production provider.
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# ── Authentication ────────────────────────────────────────────────────────
# Development-only stub user (ADR 0004). Refused when NODE_ENV=production.
AUTH_DEV_STUB="true"
AUTH_DEV_STUB_EMAIL="dev@routeeditor.local"
# Auth.js secret (from M4). Generate with: openssl rand -base64 32
AUTH_SECRET=""
